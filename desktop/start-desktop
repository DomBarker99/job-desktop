#!/usr/bin/env bash
# Runs as the "desktop" user. Starts four things and waits:
#   1. a small D-Bus "system" bus, which GNOME expects and a container lacks
#   2. Xtigervnc, the screen GNOME draws on, which also speaks VNC
#   3. the GNOME session itself
#   4. websockify, which serves the noVNC web page and passes it the screens
# If any of them stops, this script stops, and the container with it.
#
# This is screen :1, the management screen. Agents get screens of their own
# beside it; /desktop/seat makes and starts those, and is called at the end.
set -Eeuo pipefail
[[ $(id -u) == 1000 ]] || { echo 'The desktop runs as the "desktop" user (1000).' >&2; exit 1; }

resolution=${VNC_RESOLUTION:-1600x1000}
[[ $resolution =~ ^[0-9]{3,4}x[0-9]{3,4}$ ]] || { echo 'VNC_RESOLUTION must look like 1600x1000.' >&2; exit 1; }

mkdir -p "$XDG_RUNTIME_DIR" "$HOME/.config"
chmod 0700 "$XDG_RUNTIME_DIR"

# Done once per home folder, and never again, so nothing I change later is undone.
if [[ ! -e "$HOME/.config/desktop-first-start-done" ]]; then
    # No "welcome, let's set up your computer" window.
    printf 'yes\n' > "$HOME/.config/gnome-initial-setup-done"
    # GNOME's background helpers for hardware a container does not have (power,
    # Bluetooth, printers, tablets...) fail or hang without systemd. Start only
    # the ones that work here, and switch the rest off for this user. Anything
    # installed later that adds its own start-up entry is left alone.
    mkdir -p "$HOME/.config/gnome-session/sessions" "$HOME/.config/autostart"
    printf '[GNOME Session]\nName=GNOME\nRequiredComponents=org.gnome.Shell;org.gnome.SettingsDaemon.A11ySettings;org.gnome.SettingsDaemon.Keyboard;org.gnome.SettingsDaemon.MediaKeys;org.gnome.SettingsDaemon.XSettings;org.gnome.SettingsDaemon.Sound;\n' \
        > "$HOME/.config/gnome-session/sessions/gnome.session"
    keep=' at-spi-dbus-bus.desktop gnome-keyring-pkcs11.desktop gnome-keyring-secrets.desktop gnome-keyring-ssh.desktop im-launch.desktop xdg-user-dirs.desktop org.gnome.SettingsDaemon.A11ySettings.desktop org.gnome.SettingsDaemon.Keyboard.desktop org.gnome.SettingsDaemon.MediaKeys.desktop org.gnome.SettingsDaemon.XSettings.desktop org.gnome.SettingsDaemon.Sound.desktop '
    for entry in /etc/xdg/autostart/*.desktop; do
        name=${entry##*/}
        if [[ $keep != *" $name "* && ! -e "$HOME/.config/autostart/$name" ]]; then
            printf '[Desktop Entry]\nType=Application\nName=Switched off: does not work in a container\nHidden=true\n' \
                > "$HOME/.config/autostart/$name"
        fi
    done
    touch "$HOME/.config/desktop-first-start-done"
fi

# Only programs that know this random value may draw on the screen.
: > "$XAUTHORITY"
chmod 0600 "$XAUTHORITY"
xauth -f "$XAUTHORITY" add "$DISPLAY" . "$(mcookie)"

pids=()
stop_children() {
    trap - EXIT INT TERM
    if ((${#pids[@]})); then
        kill "${pids[@]}" 2>/dev/null || true
        wait "${pids[@]}" 2>/dev/null || true
    fi
}
trap stop_children EXIT
trap 'exit 0' INT TERM

# 1. The system bus. Private to this container; it reaches nothing outside it.
dbus-daemon --config-file=/desktop/system-bus.conf --nofork --nopidfile --nosyslog &
pids+=("$!")
for ((attempt=0; attempt<30; attempt++)); do
    [[ -S "$XDG_RUNTIME_DIR/system-bus" ]] && break
    kill -0 "${pids[0]}" 2>/dev/null || { echo 'The system bus stopped.' >&2; exit 1; }
    sleep 1
done
[[ -S "$XDG_RUNTIME_DIR/system-bus" ]] || { echo 'The system bus did not start.' >&2; exit 1; }

# 2. The screen. "SecurityTypes None" is the no-password part. Plain VNC stays
# inside the container (-localhost); only the web page below is reachable.
Xtigervnc "$DISPLAY" -geometry "$resolution" -depth 24 -localhost yes \
    -SecurityTypes None -auth "$XAUTHORITY" -nolisten tcp -AlwaysShared &
pids+=("$!")
for ((attempt=0; attempt<60; attempt++)); do
    xdpyinfo -display "$DISPLAY" >/dev/null 2>&1 && break
    kill -0 "${pids[1]}" 2>/dev/null || { echo 'The VNC screen stopped.' >&2; exit 1; }
    sleep 1
done
xdpyinfo -display "$DISPLAY" >/dev/null 2>&1 || { echo 'The VNC screen did not start.' >&2; exit 1; }

# 3. GNOME, with a session bus of its own.
dbus-run-session -- /desktop/session &
pids+=("$!")

# 4. The web page, on every address of the container, port 6080. One page
# serves every screen: its front page lists them, and websockify finds the
# screen a viewer asked for by name in a small file that "seat" keeps current.
# noVNC's own files are linked into a folder we can write the front page into.
web="$XDG_RUNTIME_DIR/web"
mkdir -p "$web"
for file in /usr/share/novnc/*; do
    [[ ${file##*/} == index.html ]] || ln -sfn "$file" "$web/${file##*/}"
done
/desktop/seat _page
websockify --web="$web" --token-plugin=TokenFile --token-source="$XDG_RUNTIME_DIR/vnc-tokens" 0.0.0.0:6080 &
pids+=("$!")

printf '%s\n' "${pids[@]}" > "$XDG_RUNTIME_DIR/desktop.pids"
echo "GNOME is starting on $DISPLAY at $resolution. Web page: port 6080. SSH: port 22."

# The agents' seats. Started on the side: a seat that fails must not stop the desktop.
(/desktop/seat up > "$XDG_RUNTIME_DIR/seats.log" 2>&1 &)

set +e
wait -n "${pids[@]}"
status=$?
set -e
echo "One of the desktop's four parts stopped (status $status); stopping the container." >&2
exit 1
