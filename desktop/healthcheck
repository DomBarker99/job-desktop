#!/usr/bin/env bash
# Succeeds only when the SSH server, all four parts of screen 1, a window
# manager on it (Openbox, or GNOME's) and the web page are up. Used by
# "docker run" and the test.
set -Eeuo pipefail
pgrep -u 0 -x sshd >/dev/null
[[ -s "$XDG_RUNTIME_DIR/desktop.pids" ]]
while read -r pid; do kill -0 "$pid"; done < "$XDG_RUNTIME_DIR/desktop.pids"
wm=$(xprop -root _NET_SUPPORTING_WM_CHECK | awk '{print $NF}')
[[ $wm =~ ^0x[[:xdigit:]]+$ ]]
xprop -id "$wm" _NET_WM_NAME | grep -E '"(Openbox|GNOME Shell)"' >/dev/null
curl --fail --silent --max-time 5 http://127.0.0.1:6080/vnc.html >/dev/null
