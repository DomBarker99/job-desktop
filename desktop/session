#!/usr/bin/env bash
# Runs inside screen 1's own D-Bus session, and is what "the desktop" on screen
# 1 amounts to. There are two kinds, chosen by DESKTOP_SESSION_KIND:
#
#   plain   (the default) No desktop at all. A bare screen with Openbox, the
#           keyring service, and my own start-up entries. Screen 1 is then only
#           a place for the machine's own windows, such as the Nextcloud
#           client's. It saves well over a gigabyte of memory.
#   gnome   The full GNOME desktop, as this image started out.
#
# Either way, the programs in ~/.config/autostart/ are started: that is where
# the OpenClaw gateway and the Nextcloud client are switched on. GNOME does it
# itself; in the plain kind the loop below does.
set -Eeuo pipefail
# Terminals and SSH logins read this file to find the running session.
printf '%s\n' "$DBUS_SESSION_BUS_ADDRESS" > "$XDG_RUNTIME_DIR/session-bus.address"

if [[ ${DESKTOP_SESSION_KIND:-plain} == gnome ]]; then
    # No lock screen and no idle blanking: there is no password to unlock with.
    gsettings set org.gnome.desktop.screensaver lock-enabled false
    gsettings set org.gnome.desktop.lockdown disable-lock-screen true
    gsettings set org.gnome.desktop.session idle-delay 0
    # No "tour" window after a GNOME upgrade.
    gsettings set org.gnome.shell welcome-dialog-last-shown-version "$(gnome-shell --version | awk '{print $NF}')"
    exec gnome-session --session=gnome --disable-acceleration-check
fi

# The keyring service. Programs such as the Nextcloud client keep their sign-in
# in it, and would ask me to sign in again at every start without it.
if command -v gnome-keyring-daemon >/dev/null; then
    gnome-keyring-daemon --foreground --components=secrets > "$XDG_RUNTIME_DIR/keyring.log" 2>&1 &
    sleep 1
fi

# My start-up entries: every .desktop file in ~/.config/autostart that is not
# switched off. An entry that crashes is not started again.
for entry in "$HOME"/.config/autostart/*.desktop; do
    [[ -e $entry ]] || continue
    if grep -qiE '^(Hidden=true|X-GNOME-Autostart-enabled=false)' "$entry"; then continue; fi
    command=$(sed -n 's/^Exec=//p' "$entry" | head -n 1 | sed -E 's/ %[a-zA-Z]//g')
    [[ -n $command ]] || continue
    delay=$(sed -n 's/^X-GNOME-Autostart-Delay=//p' "$entry" | head -n 1)
    name=$(basename "$entry" .desktop)
    ( sleep "${delay:-0}"; exec sh -c "$command" ) > "$XDG_RUNTIME_DIR/autostart-$name.log" 2>&1 &
done

# Openbox with its own default settings: a right-click on the empty screen
# gives a small menu, which is all the "desktop" there is here. If Openbox
# stops, this script ends and the container is started again.
exec openbox
